<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base dark theme -->
    <style name="Theme.Neuropulse" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_purple</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorSecondaryVariant">@color/accent_green</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Alert dialog theme -->
    <style name="Theme.Neuropulse.Alert" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
    </style>

    <!-- Blocking overlay theme -->
    <style name="Theme.Neuropulse.Blocking" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/calming_bg</item>
        <item name="android:statusBarColor">@color/calming_bg</item>
        <item name="android:navigationBarColor">@color/calming_bg</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Glassmorphism card -->
    <style name="Widget.Neuropulse.GlassCard">
        <item name="android:background">@drawable/card_glass_bg</item>
        <item name="android:padding">20dp</item>
        <item name="android:layout_margin">12dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Primary button -->
    <style name="Widget.Neuropulse.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/accent_blue</item>
    </style>

    <!-- Secondary / outline button -->
    <style name="Widget.Neuropulse.OutlinedButton"
        parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/bg_card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Danger button (for alerts) -->
    <style name="Widget.Neuropulse.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/accent_red</item>
    </style>
</resources>