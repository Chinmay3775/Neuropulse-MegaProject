<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Critical permissions for usage monitoring -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Service permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Neuropulse"
        tools:targetApi="34">

        <!-- Main Activity (Launcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Neuropulse"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Permission Helper Activity -->
        <activity
            android:name=".PermissionHelperActivity"
            android:exported="false"
            android:label="Grant Permissions"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Neuropulse"
            android:screenOrientation="portrait" />

        <!-- Enhanced Debug Activity -->
        <activity
            android:name=".EnhancedDebugActivity"
            android:exported="false"
            android:label="Debug Monitor"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Neuropulse"
            android:screenOrientation="portrait" />

        <!-- Background Usage Monitor Service -->
        <service
            android:name=".services.UsageMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <activity
            android:name=".ui.AlertActivity"
            android:theme="@android:style/Theme.DeviceDefault.Dialog"
            android:excludeFromRecents="true"
            android:taskAffinity="" />


    </application>

</manifest>