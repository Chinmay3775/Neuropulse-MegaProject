<?xml version="1.0" encoding="utf-8"?>
<!-- Alert overlay root — providing a transparent container for the card -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="@drawable/overlay_alert_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Risk indicator bar -->
        <View
            android:id="@+id/overlayRiskBar"
            android:layout_width="60dp"
            android:layout_height="4dp"
            android:layout_marginBottom="16dp"
            android:background="@color/accent_red" />

        <!-- Warning icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="44sp"
            android:layout_marginBottom="10dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/overlayAlertTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time for a Break"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <!-- App name and duration -->
        <TextView
            android:id="@+id/overlayAlertAppInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You've been on Instagram for 45 min"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <!-- Risk reason -->
        <TextView
            android:id="@+id/overlayAlertReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High dopamine stimulation detected"
            android:textColor="@color/accent_amber"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <!-- Escalation warning -->
        <TextView
            android:id="@+id/overlayEscalationWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/accent_red"
            android:textSize="11sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/bg_card_border" />

        <!-- Suggestion -->
        <TextView
            android:id="@+id/overlayAlertSuggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Try taking a 5-minute walk"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center"
            android:background="@drawable/card_glass_bg"
            android:padding="10dp"
            android:layout_marginBottom="20dp" />

        <!-- Take a Break Button -->
        <Button
            android:id="@+id/overlayBtnTakeBreak"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Take a Break"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="@color/accent_green"
            android:layout_marginBottom="10dp" />

        <!-- Continue Button -->
        <Button
            android:id="@+id/overlayBtnContinue"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Continue Using"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/bg_card"
            android:layout_marginBottom="4dp" />

    </LinearLayout>
</FrameLayout>
